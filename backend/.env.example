# =====================================================================
# PHARMATRUST DEPLOYMENT ENVIRONMENT CONFIGURATION
# Copy this file to .env before starting in production:
# cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ---------------------------------------------------------------------
NODE_ENV=production
PORT=3000
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------
# 2. GOOGLE MAPS API CREDENTIALS
# Required for rendering real-time route maps, directional polylines, 
# and reverse geocoding of GPS telemetry waypoints.
# Enable in Google Cloud Console:
#   - Maps JavaScript API
#   - Geocoding API (optional for street address translation)
# Restrict this key to your HTTP referrer domain in production.
# ---------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=AIzaSyADGlc79fkUlpVN0SuU8EQ_mYwQL3QaAXg

# ---------------------------------------------------------------------
# 3. CONSORTIUM SECURITY & JWT SIGNING SECRET
# Used to sign and verify role-based actor tokens for Manufacturer,
# Transporter, and Pharmacy operations. Use a high-entropy string.
# ---------------------------------------------------------------------
JWT_SECRET=4f9b8c2d1e0a7f5b3c8e1d2a4f6b8c0e2d4a6f8b0c2e4a6f8b0c2e4a6f8b0c2e

# ---------------------------------------------------------------------
# 4. HYPERLEDGER FABRIC / IBM BLOCKCHAIN PLATFORM (ENTERPRISE PKI)
# Set USE_MOCK_LEDGER=false to switch from local in-memory simulation
# to a live Hyperledger Fabric peer network.
# ---------------------------------------------------------------------
USE_MOCK_LEDGER=false

FABRIC_CHANNEL=pharma-tracking-channel
FABRIC_CHAINCODE=pharma-chaincode
FABRIC_MSP_ID=ManufacturerMSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.manufacturer.pharma.com

# Absolute paths to organization crypto material (X.509 PKI certificates)
FABRIC_TLS_CERT_PATH=/etc/hyperledger/crypto/peers/peer0.manufacturer.pharma.com/tls/ca.crt
FABRIC_USER_CERT_PATH=/etc/hyperledger/crypto/users/User1@manufacturer.pharma.com/msp/signcerts/cert.pem
FABRIC_KEY_DIR_PATH=/etc/hyperledger/crypto/users/User1@manufacturer.pharma.com/msp/keystore
